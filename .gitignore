target/

# Model weights never go in a repo (photocraft agents/SPEC.md): ONNX and safetensors only, and
# no pickle formats at all (.ckpt / .pt / .bin).
*.onnx
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
models/

# The exception: docs/models/ holds notes about models (docs/models/lama.md), never weights. The
# weight patterns above still apply inside it, so a .onnx dropped there stays untracked.
!docs/models/
